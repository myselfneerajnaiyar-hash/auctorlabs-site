# Required for AI planning, writing, review, and optional images.
OPENAI_API_KEY=

# Required for search-backed discovery and research.
SERP_API_KEY=

# Optional editorial configuration.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-1
BLOG_MIN_QUALITY_SCORE=80
BLOG_MAX_REVISIONS=1

# Supabase Auth and public database endpoint.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket used for generated Blog Studio assets.
BLOG_ASSET_BUCKET=blog-assets
